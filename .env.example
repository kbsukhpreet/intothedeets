# Copy these into Vercel → Project → Settings → Environment Variables
# (or into a local .env.local file if you run the app on your computer).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The public address of the site (used in sign-up confirmation emails and invite links)
NEXT_PUBLIC_SITE_URL=https://intothedeets.com

# Email notifications (resend.com). Server-only: do NOT prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_your_key_here
# Optional: who emails come from (domain must be verified in Resend)
EMAIL_FROM=Into the Deets <notifications@intothedeets.com>
